# Copy to infra/.env — that file is gitignored and must never be committed.
#
#   cp infra/.env.example infra/.env
#
# Every value has a working local default in docker-compose.yml, so an empty
# .env is enough to boot the stack. Override here when you need to.

# ── Branding (the first white-label knob) ─────────────────────────────────────
PRODUCT_NAME=White Label App

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# ── Redis / Qdrant ────────────────────────────────────────────────────────────
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
DEBUG=false
# Comma-separated. Locked to known origins — never "*", since the Phase 1 auth
# cookies are sent with credentials.
CORS_ORIGINS=http://localhost:3000

# ── Not used yet — listed so the shape is known before the phases land ────────
# Phase 1 (auth): a random 32+ byte secret, e.g. `openssl rand -hex 32`
# JWT_SECRET=
# Phase 5 (AI layer): LLM provider credentials
# LLM_API_KEY=
